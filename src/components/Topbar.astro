---
import { MobileNav } from "@/components/MobileNav";
import { Button } from "@/components/ui/button";

const { user } = Astro.locals;
const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Ponaglenia" },
  { href: "/invoices", label: "Faktury" },
  { href: "/history", label: "Historia" },
  { href: "/clients", label: "Klienci" },
  { href: "/settings", label: "Ustawienia" },
].map((link) => ({
  ...link,
  active: link.href === "/" ? pathname === "/" : pathname.startsWith(link.href),
}));
---

<div class="mb-4 flex items-center justify-between gap-2 rounded-xl border bg-card px-4 py-2 text-sm text-card-foreground">
  <nav class="hidden flex-wrap items-center gap-x-4 gap-y-1 sm:mr-auto sm:flex" aria-label="Główna nawigacja">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.active ? "page" : undefined}
        class:list={["font-medium", link.active ? "text-foreground" : "text-muted-foreground hover:text-foreground"]}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <div class="sm:hidden">
    <MobileNav links={links} client:load />
  </div>
  <span class="min-w-0 flex-1 truncate text-center text-muted-foreground sm:flex-none">{user?.email}</span>
  <form method="POST" action="/api/auth/signout">
    <Button type="submit" variant="link">
      {" "}
      Wyloguj{" "}
    </Button>
  </form>
</div>
