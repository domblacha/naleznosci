---
import { Button } from "@/components/ui/button";

const { user } = Astro.locals;
const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Faktury" },
  { href: "/history", label: "Historia" },
  { href: "/clients", label: "Klienci" },
  { href: "/settings", label: "Ustawienia" },
];
---

<div class="mb-4 flex flex-col gap-1 rounded-xl border bg-card px-4 py-2 text-sm text-card-foreground sm:flex-row sm:items-center sm:justify-between">
  <nav class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-label="Główna nawigacja">
    {links.map((link) => {
      const active = link.href === "/" ? pathname === "/" : pathname.startsWith(link.href);
      return (
        <a
          href={link.href}
          aria-current={active ? "page" : undefined}
          class:list={["font-medium", active ? "text-foreground" : "text-muted-foreground hover:text-foreground"]}
        >
          {link.label}
        </a>
      );
    })}
  </nav>
  <div class="order-first flex items-center justify-between gap-2 sm:contents">
    <span class="min-w-0 truncate text-muted-foreground">{user?.email}</span>
    <form method="POST" action="/api/auth/signout">
      <Button type="submit" variant="link">
        {" "}
        Wyloguj{" "}
      </Button>
    </form>
  </div>
</div>
