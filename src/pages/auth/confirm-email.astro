---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent } from "@/components/ui/card";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Rejestracja udana",
      description: "Twoje konto zostało utworzone. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      emoji: "📧",
      heading: "Sprawdź skrzynkę",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <div class="flex min-h-screen items-center justify-center p-4">
    <Card class="w-full max-w-sm text-center">
      <CardContent>
        <div class="mb-4 text-5xl">{content.emoji}</div>
        <h1 class="mb-3 text-2xl font-bold text-foreground">{content.heading}</h1>
        <p class="mb-6 text-muted-foreground">{content.description}</p>
        <a href="/auth/signin" class="text-sm text-primary underline-offset-4 hover:underline">
          {content.linkText}
        </a>
      </CardContent>
    </Card>
  </div>
</Layout>
