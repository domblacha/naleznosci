---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import SignInForm from "@/components/auth/SignInForm";
import { authErrorMessage } from "@/lib/auth-errors";

const error = Astro.url.searchParams.get("error");
const serverError = authErrorMessage(error);
---

<Layout title="Zaloguj się">
  <div class="flex min-h-screen items-center justify-center p-4">
    <Card class="w-full max-w-sm">
      <CardHeader>
        <h1 class="text-center text-2xl font-bold text-foreground">Zaloguj się</h1>
      </CardHeader>
      <CardContent>
        <SignInForm serverError={serverError} client:load />
        <p class="mt-4 text-center text-sm text-muted-foreground">
          Nie masz konta?{" "}
          <a href="/auth/signup" class="text-primary underline-offset-4 hover:underline">
            Zarejestruj się
          </a>
        </p>
      </CardContent>
    </Card>
  </div>
</Layout>
