---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import SignUpForm from "@/components/auth/SignUpForm";
import { authErrorMessage } from "@/lib/auth-errors";

const error = Astro.url.searchParams.get("error");
const serverError = authErrorMessage(error);
---

<Layout title="Załóż konto">
  <div class="flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm">
      <CardHeader>
        <h1 class="text-center text-2xl font-bold text-foreground">Załóż konto</h1>
      </CardHeader>
      <CardContent>
        <SignUpForm serverError={serverError} client:load />
        <p class="mt-4 text-center text-sm text-muted-foreground">
          Masz już konto?{" "}
          <a href="/auth/signin" class="text-primary underline-offset-4 hover:underline">
            Zaloguj się
          </a>
        </p>
      </CardContent>
    </Card>
  </div>
</Layout>
