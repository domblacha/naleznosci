---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import { KitchenSinkForms } from "@/components/dev/KitchenSinkForms";
import { Card, CardContent, CardHeader } from "@/components/ui/card";

export const prerender = false;

const isDev = import.meta.env.DEV;
if (!isDev) Astro.response.status = 404;
---

<Layout title="Kitchen sink">
  {isDev && (
    <main class="mx-auto max-w-xl space-y-8 p-6">
      <h1 class="text-2xl font-bold text-foreground">Kitchen sink: stany komponentów</h1>

      <KitchenSinkForms client:load />

      <section class="space-y-3">
        <h2 class="text-sm font-semibold text-muted-foreground">Banner: info, warning, error</h2>
        <Banner variant="info">Wariant informacyjny</Banner>
        <Banner variant="warning">Wariant ostrzeżenia</Banner>
        <Banner variant="error">Wariant błędu</Banner>
      </section>

      <section class="space-y-3">
        <h2 class="text-sm font-semibold text-muted-foreground">Link</h2>
        <a href="/dev/ui" class="text-primary underline-offset-4 hover:underline">
          Przykładowy link
        </a>
      </section>

      <section class="space-y-3">
        <h2 class="text-sm font-semibold text-muted-foreground">Card</h2>
        <Card>
          <CardHeader>
            <h3 class="text-lg font-bold text-foreground">Tytuł karty</h3>
          </CardHeader>
          <CardContent>
            <p class="text-sm text-muted-foreground">Treść karty.</p>
          </CardContent>
        </Card>
      </section>

      <section class="space-y-3">
        <h2 class="text-sm font-semibold text-muted-foreground">Empty</h2>
        <p class="text-sm text-muted-foreground">empty: N/A — formularze nie listują danych</p>
      </section>
    </main>
  )}
</Layout>
