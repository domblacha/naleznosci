---
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { HistoryManager } from "@/components/invoices/HistoryManager";
import { createClient } from "@/lib/supabase";
import { listCancelledInvoices, listPaidInvoices } from "@/lib/services/invoices";
import { todayInPoland } from "@/lib/escalation";
import { Alert, AlertDescription } from "@/components/ui/alert";
import type { Invoice } from "@/types";

export const prerender = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let invoices: Invoice[] = [];
let cancelledInvoices: Invoice[] = [];
let loadError: string | null = null;
if (!supabase) {
  loadError = "Historia faktur jest niedostępna: brak konfiguracji serwera.";
} else {
  try {
    [invoices, cancelledInvoices] = await Promise.all([listPaidInvoices(supabase), listCancelledInvoices(supabase)]);
  } catch {
    loadError = "Nie udało się wczytać historii faktur. Odśwież stronę.";
  }
}
const today = todayInPoland(new Date());
---

<Layout title="Historia">
  <div class="min-h-screen p-4">
    <Topbar />
    <main class="mx-auto max-w-5xl space-y-8 py-8">
      <h1 class="text-3xl font-bold text-foreground">Historia</h1>
      {loadError ? (
        <Alert variant="destructive">
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : (
        <HistoryManager initialPaid={invoices} initialCancelled={cancelledInvoices} today={today} client:load />
      )}
    </main>
  </div>
</Layout>
