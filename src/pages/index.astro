---
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { RemindersManager } from "@/components/invoices/RemindersManager";
import { createClient } from "@/lib/supabase";
import { listActiveClients } from "@/lib/services/clients";
import { listOpenInvoices } from "@/lib/services/invoices";
import { getSettings } from "@/lib/services/settings";
import { getSenderProfile } from "@/lib/services/sender-profile";
import { EMPTY_SENDER_PROFILE } from "@/lib/sender-profile";
import { DEFAULT_ESCALATION_SETTINGS } from "@/lib/charges";
import { todayInPoland } from "@/lib/escalation";
import { Alert, AlertDescription } from "@/components/ui/alert";
import type { Client, EscalationSettings, Invoice, SenderProfile } from "@/types";

export const prerender = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let invoices: Invoice[] = [];
let clients: Client[] = [];
let settings: EscalationSettings = DEFAULT_ESCALATION_SETTINGS;
let sender: SenderProfile = EMPTY_SENDER_PROFILE;
let loadError: string | null = null;
if (!supabase) {
  loadError = "Ponaglenia są niedostępne: brak konfiguracji serwera.";
} else {
  try {
    [invoices, clients, settings, sender] = await Promise.all([
      listOpenInvoices(supabase),
      listActiveClients(supabase),
      getSettings(supabase),
      getSenderProfile(supabase),
    ]);
  } catch {
    loadError = "Nie udało się wczytać ponagleń. Odśwież stronę.";
  }
}
const today = todayInPoland(new Date());
---

<Layout title="Ponaglenia">
  <div class="min-h-screen p-4">
    <Topbar />
    <main class="mx-auto max-w-5xl space-y-4 py-8">
      <h1 class="text-3xl font-bold text-foreground">Ponaglenia</h1>
      {loadError ? (
        <Alert variant="destructive">
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : (
        <RemindersManager
          invoices={invoices}
          hasClients={clients.length > 0}
          today={today}
          settings={settings}
          sender={sender}
          client:load
        />
      )}
    </main>
  </div>
</Layout>
