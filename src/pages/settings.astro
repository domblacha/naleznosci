---
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { SettingsTabs } from "@/components/settings/SettingsTabs";
import { createClient } from "@/lib/supabase";
import { getSettings } from "@/lib/services/settings";
import { getSenderProfile } from "@/lib/services/sender-profile";
import { Alert, AlertDescription } from "@/components/ui/alert";
import type { EscalationSettings, SenderProfile } from "@/types";

export const prerender = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let settings: EscalationSettings | null = null;
let senderProfile: SenderProfile | null = null;
let loadError: string | null = null;
if (!supabase) {
  loadError = "Ustawienia są niedostępne: brak konfiguracji serwera.";
} else {
  try {
    [settings, senderProfile] = await Promise.all([getSettings(supabase), getSenderProfile(supabase)]);
  } catch {
    loadError = "Nie udało się wczytać ustawień. Odśwież stronę.";
  }
}
---

<Layout title="Ustawienia">
  <div class="min-h-screen p-4">
    <Topbar />
    <main class="mx-auto max-w-3xl space-y-4 py-8">
      <h1 class="text-3xl font-bold text-foreground">Ustawienia</h1>
      {loadError || !settings || !senderProfile ? (
        <Alert variant="destructive">
          <AlertDescription>{loadError}</AlertDescription>
        </Alert>
      ) : (
        <SettingsTabs initialProfile={senderProfile} initialSettings={settings} client:load />
      )}
    </main>
  </div>
</Layout>
